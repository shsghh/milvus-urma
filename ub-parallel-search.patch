+// Row sharding for the UB delegator fast path.
+//
+// The proxy splits one client search into one SearchRequest per vchannel and
+// sends every one of them the SAME nq query rows. UB search is a global graph
+// walk, so each channel can search a disjoint subset of the rows and the
+// proxy's per-query reduce merges the partial results:
+//
+//	row i belongs to channel rank i % mod
+//
+// With mod == dmlChannelNum that turns "8 QNs each run all nq rows" into
+// "8 QNs each run nq/8 rows", and the per-QN C++ scheduler can then run those
+// rows concurrently on its search workers.
+//
+// Correctness hinges on mod being the number of requests that actually reach
+// a QN for one client search, i.e. the number of vchannels of the collection.
+// That is rootCoord.dmlChannelNum at collection creation. We additionally
+// require it to match the index's shard count (the topology invariant:
+// shards == vchannels == QN ranks), and disable sharding otherwise rather
+// than risk silently dropping rows.
+
+package ub
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"sync/atomic"
+
+	"google.golang.org/protobuf/proto"
+
+	"github.com/milvus-io/milvus-proto/go-api/v3/commonpb"
+	"github.com/milvus-io/milvus-proto/go-api/v3/schemapb"
+	"github.com/milvus-io/milvus/pkg/v3/proto/internalpb"
+	"github.com/milvus-io/milvus/pkg/v3/proto/querypb"
+	"github.com/milvus-io/milvus/pkg/v3/util/merr"
+	"github.com/milvus-io/milvus/pkg/v3/util/paramtable"
+)
+
+// ubExpectedShardCount is the index shard count reported by global.meta,
+// staged by the querynode init path. 0 means "unknown".
+var ubExpectedShardCount atomic.Int64
+
+// SetExpectedShardCount stages the UB index shard count. Called once during
+// querynode init, after the UB runtime is seeded.
+func SetExpectedShardCount(count int) {
+	if count > 0 {
+		ubExpectedShardCount.Store(int64(count))
+	}
+}
+
+// ExpectedShardCount returns the staged UB index shard count (0 = unknown).
+func ExpectedShardCount() int {
+	return int(ubExpectedShardCount.Load())
+}
+
+// ShardModulus returns how many disjoint row slices one client search is
+// split into, or 0 when row sharding is unavailable/unsafe.
+func ShardModulus() int {
+	if !paramtable.Get().QueryNodeCfg.UbRowSharding.GetAsBool() {
+		return 0
+	}
+	mod := int(paramtable.Get().RootCoordCfg.DmlChannelNum.GetAsInt())
+	if mod < 2 {
+		return 0
+	}
+	// Topology invariant: shard count == vchannel count. If they disagree the
+	// rank coverage of `i % mod` would leave rows unsearched, so keep the
+	// legacy behaviour instead.
+	if expected := ExpectedShardCount(); expected > 0 && expected != mod {
+		return 0
+	}
+	return mod
+}
+
+// ChannelRank maps a vchannel name (by-dev-rootcoord-dml_<n>_<cid>v<k>) to its
+// row-slice rank. ok is false when sharding is disabled or the name does not
+// carry a usable index.
+func ChannelRank(channel string) (rank int, mod int, ok bool) {
+	mod = ShardModulus()
+	if mod == 0 {
+		return 0, 0, false
+	}
+	n, err := parseDmlChannelIndex(channel)
+	if err != nil || n < 0 || n >= mod {
+		return 0, 0, false
+	}
+	return n, mod, true
+}
+
+const dmlChannelIndexToken = "dml_"
+
+// parseDmlChannelIndex extracts n from "...dml_<n>_<collectionID>v<k>".
+func parseDmlChannelIndex(channel string) (int, error) {
+	pos := strings.Index(channel, dmlChannelIndexToken)
+	if pos < 0 {
+		return 0, fmt.Errorf("ub: channel %q carries no dml index", channel)
+	}
+	rest := channel[pos+len(dmlChannelIndexToken):]
+	end := strings.IndexByte(rest, '_')
+	if end < 0 {
+		end = len(rest)
+	}
+	if end == 0 {
+		return 0, fmt.Errorf("ub: channel %q has an empty dml index", channel)
+	}
+	n, err := strconv.Atoi(rest[:end])
+	if err != nil {
+		return 0, fmt.Errorf("ub: channel %q has a non-numeric dml index: %w", channel, err)
+	}
+	return n, nil
+}
+
+// RowSlice describes one channel's share of a client search.
+type RowSlice struct {
+	// Request is the forwarded/local request carrying only NqOut rows.
+	Request *querypb.SearchRequest
+	Rank    int
+	Mod     int
+	NqIn    int64
+	NqOut   int64
+	TopK    int64
+	ReqID   int64
+	Metric  string
+}
+
+// SliceForChannel returns the rows this channel owns, or nil when row
+// sharding does not apply (disabled, unusable channel name, empty batch...).
+// The returned request is a fresh message: the caller's request is not
+// modified and stays usable for the fallback paths.
+func SliceForChannel(req *querypb.SearchRequest, channel string) (*RowSlice, error) {
+	if req == nil || req.GetReq() == nil {
+		return nil, nil
+	}
+	rank, mod, ok := ChannelRank(channel)
+	if !ok {
+		return nil, nil
+	}
+	values, placeholder, err := placeholderRows(req.GetReq().GetPlaceholderGroup())
+	if err != nil {
+		return nil, err
+	}
+	if len(values) == 0 {
+		return nil, nil
+	}
+
+	picked := make([][]byte, 0, (len(values)+mod-1)/mod)
+	for i := rank; i < len(values); i += mod {
+		picked = append(picked, values[i])
+	}
+
+	// Reuse the original placeholder value (tag/type/unknown fields), only
+	// swapping the row payload. proto.Clone of the placeholder value is
+	// cheap: it shares the row byte slices.
+	value := proto.Clone(placeholder).(*commonpb.PlaceholderValue)
+	value.Values = picked
+	group := &commonpb.PlaceholderGroup{
+		Placeholders: []*commonpb.PlaceholderValue{value},
+	}
+	raw, err := proto.Marshal(group)
+	if err != nil {
+		return nil, fmt.Errorf("ub: marshal sliced placeholder: %w", err)
+	}
+
+	inner := cloneSearchRequestWithoutPlaceholder(req.GetReq())
+	inner.PlaceholderGroup = raw
+	inner.Nq = int64(len(picked))
+
+	topk := req.GetReq().GetTopk()
+	if topk <= 0 {
+		if planTopk, _, perr := parsePlan(req.GetReq()); perr == nil {
+			topk = planTopk
+		}
+	}
+	if topk <= 0 {
+		// ScatterResult needs the row stride; without it, keep the legacy
+		// path rather than emit a result the proxy cannot lay out.
+		return nil, nil
+	}
+
+	return &RowSlice{
+		Request: &querypb.SearchRequest{
+			Req:             inner,
+			DmlChannels:     req.GetDmlChannels(),
+			Scope:           req.GetScope(),
+			TotalChannelNum: req.GetTotalChannelNum(),
+		},
+		Rank:   rank,
+		Mod:    mod,
+		NqIn:   int64(len(values)),
+		NqOut:  int64(len(picked)),
+		TopK:   topk,
+		ReqID:  req.GetReq().GetReqID(),
+		Metric: req.GetReq().GetMetricType(),
+	}, nil
+}
+
+// placeholderRows returns the per-row byte slices of a placeholder group.
+// Each Values[i] is one query row (dim*4 bytes), so slicing rows never needs
+// to decode floats.
+func placeholderRows(raw []byte) ([][]byte, *commonpb.PlaceholderValue, error) {
+	if len(raw) == 0 {
+		return nil, nil, fmt.Errorf("ub: empty placeholder group")
+	}
+	group := &commonpb.PlaceholderGroup{}
+	if err := proto.Unmarshal(raw, group); err != nil {
+		return nil, nil, fmt.Errorf("ub: unmarshal placeholder group: %w", err)
+	}
+	if len(group.GetPlaceholders()) != 1 {
+		return nil, nil, fmt.Errorf("ub: placeholder group has %d placeholders, want 1", len(group.GetPlaceholders()))
+	}
+	placeholder := group.GetPlaceholders()[0]
+	return placeholder.GetValues(), placeholder, nil
+}
+
+// cloneSearchRequestWithoutPlaceholder clones the request metadata while
+// avoiding a copy of the (multi-megabyte) placeholder. The source request is
+// owned by the current RPC; the temporary field swap is restored before
+// returning.
+func cloneSearchRequestWithoutPlaceholder(src *internalpb.SearchRequest) *internalpb.SearchRequest {
+	saved := src.PlaceholderGroup
+	src.PlaceholderGroup = nil
+	clone, _ := proto.Clone(src).(*internalpb.SearchRequest)
+	src.PlaceholderGroup = saved
+	if clone == nil {
+		return &internalpb.SearchRequest{}
+	}
+	return clone
+}
+
+// ScatterResult maps a slice result back into the full nq row space: rows
+// owned by this rank carry their topk, every other row reports 0 rows, and
+// Ids/Scores stay densely packed in query order. That is exactly the shape
+// the proxy reduce consumes for a shard that returned nothing for a query
+// (offsets come from Topks, see reduceSearchResultDataNoGroupBy).
+func ScatterResult(sliced *internalpb.SearchResults, s *RowSlice) *internalpb.SearchResults {
+	if s == nil {
+		return sliced
+	}
+	if sliced == nil || sliced.GetResultData() == nil {
+		return emptySearchResult(s.NqIn, s.TopK, s.ReqID, s.Metric)
+	}
+
+	src := sliced.GetResultData()
+	srcTopks := src.GetTopks()
+	ids := src.GetIds().GetIntId().GetData()
+	scores := src.GetScores()
+
+	topks := make([]int64, s.NqIn)
+	outIDs := make([]int64, 0, len(ids))
+	outScores := make([]float32, 0, len(scores))
+	for i := int64(0); i < s.NqIn; i++ {
+		if int(i)%s.Mod != s.Rank {
+			continue
+		}
+		j := int(i) / s.Mod
+		if j >= len(srcTopks) {
+			break
+		}
+		k := int(srcTopks[j])
+		if k <= 0 {
+			continue
+		}
+		if k > int(s.TopK) {
+			k = int(s.TopK)
+		}
+		// The producer (RunSearchAsWorker) packs the slice rows at a fixed
+		// stride of TopK, so row j starts at j*TopK and may use fewer than
+		// TopK entries.
+		base := j * int(s.TopK)
+		if base+k > len(ids) || base+k > len(scores) {
+			break
+		}
+		outIDs = append(outIDs, ids[base:base+k]...)
+		outScores = append(outScores, scores[base:base+k]...)
+		topks[i] = int64(k)
+	}
+
+	return &internalpb.SearchResults{
+		Status:     sliced.GetStatus(),
+		ReqID:      s.ReqID,
+		MetricType: s.Metric,
+		NumQueries: s.NqIn,
+		TopK:       s.TopK,
+		ResultData: &schemapb.SearchResultData{
+			NumQueries: s.NqIn,
+			TopK:       s.TopK,
+			Ids: &schemapb.IDs{
+				IdField: &schemapb.IDs_IntId{IntId: &schemapb.LongArray{Data: outIDs}},
+			},
+			Scores:     outScores,
+			Topks:      topks,
+			FieldsData: []*schemapb.FieldData{},
+		},
+	}
+}
+
+// emptySearchResult builds the "no rows contributed" reply for nq rows.
+func emptySearchResult(nq, topk int64, reqID int64, metricType string) *internalpb.SearchResults {
+	return &internalpb.SearchResults{
+		Status:     merr.Success(),
+		ReqID:      reqID,
+		MetricType: metricType,
+		NumQueries: nq,
+		TopK:       topk,
+		ResultData: &schemapb.SearchResultData{
+			NumQueries: nq,
+			TopK:       topk,
+			Ids: &schemapb.IDs{
+				IdField: &schemapb.IDs_IntId{IntId: &schemapb.LongArray{}},
+			},
+			Scores:     []float32{},
+			Topks:      make([]int64, nq),
+			FieldsData: []*schemapb.FieldData{},
+		},
+	}
+}

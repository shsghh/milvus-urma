+
+package ub
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/milvus-io/milvus-proto/go-api/v3/commonpb"
+	"github.com/milvus-io/milvus-proto/go-api/v3/schemapb"
+	"github.com/milvus-io/milvus/pkg/v3/proto/internalpb"
+	"github.com/milvus-io/milvus/pkg/v3/proto/querypb"
+	"github.com/milvus-io/milvus/pkg/v3/util/paramtable"
+)
+
+// testShardModulus returns the modulus row sharding would use in this
+// process, or 0 when it is disabled. The tests follow the config instead of
+// hard-coding 8/16 so they work on any default.
+func testShardModulus(t *testing.T) int {
+	t.Helper()
+	if !paramtable.Get().QueryNodeCfg.UbRowSharding.GetAsBool() {
+		return 0
+	}
+	mod := int(paramtable.Get().RootCoordCfg.DmlChannelNum.GetAsInt())
+	if mod < 2 {
+		return 0
+	}
+	// Satisfy the "dmlChannelNum == shard count" invariant for the test.
+	SetExpectedShardCount(mod)
+	return mod
+}
+
+func TestChannelRank(t *testing.T) {
+	mod := testShardModulus(t)
+	if mod == 0 {
+		t.Skip("row sharding is disabled in this configuration")
+	}
+
+	last := fmt.Sprintf("by-dev-rootcoord-dml_%d_462468953791000000v0", mod-1)
+	rank, gotMod, ok := ChannelRank(last)
+	require.True(t, ok, "last dml channel must map to a rank")
+	assert.Equal(t, mod-1, rank)
+	assert.Equal(t, mod, gotMod)
+
+	_, _, ok = ChannelRank(fmt.Sprintf("by-dev-rootcoord-dml_%d_462468953791000000v0", mod))
+	assert.False(t, ok, "index outside [0,mod) must be rejected")
+
+	_, _, ok = ChannelRank("no-dml-index-here")
+	assert.False(t, ok, "channel without a dml index must be rejected")
+
+	_, _, ok = ChannelRank("by-dev-rootcoord-dml_x_462468953791000000v0")
+	assert.False(t, ok, "non-numeric dml index must be rejected")
+}
+
+// TestSliceForChannel verifies the strided split: channel rank r owns rows
+// i%mod==r, the sliced request carries exactly those rows, the original
+// request is left untouched, and no float decode is involved.
+func TestSliceForChannel(t *testing.T) {
+	mod := testShardModulus(t)
+	if mod == 0 {
+		t.Skip("row sharding is disabled in this configuration")
+	}
+
+	const nq, dim, topk = 10, 4, 3
+	inner := makeSearchRequest(t, topk, 200, nq, dim, "L2")
+	before := append([]byte(nil), inner.PlaceholderGroup...)
+	req := &querypb.SearchRequest{Req: inner, DmlChannels: []string{"chan"}}
+
+	rank := mod - 1
+	channel := fmt.Sprintf("by-dev-rootcoord-dml_%d_462468953791000000v0", rank)
+	sliced, err := SliceForChannel(req, channel)
+	require.NoError(t, err)
+	require.NotNil(t, sliced)
+
+	wantRows := 0
+	for i := 0; i < nq; i++ {
+		if i%mod == rank {
+			wantRows++
+		}
+	}
+	assert.Equal(t, rank, sliced.Rank)
+	assert.Equal(t, mod, sliced.Mod)
+	assert.Equal(t, int64(nq), sliced.NqIn)
+	assert.Equal(t, int64(wantRows), sliced.NqOut)
+	assert.Equal(t, int64(topk), sliced.TopK)
+	assert.Equal(t, int64(12345), sliced.ReqID)
+	assert.Equal(t, "L2", sliced.Metric)
+	assert.Equal(t, int64(wantRows), sliced.Request.GetReq().GetNq())
+
+	// The sliced placeholder must contain exactly the owned rows, in order.
+	group := &commonpb.PlaceholderGroup{}
+	require.NoError(t, proto.Unmarshal(sliced.Request.GetReq().GetPlaceholderGroup(), group))
+	require.Len(t, group.GetPlaceholders(), 1)
+	values := group.GetPlaceholders()[0].GetValues()
+	require.Len(t, values, wantRows)
+	at := 0
+	for i := 0; i < nq; i++ {
+		if i%mod != rank {
+			continue
+		}
+		// makeSearchRequest encodes row i as floats i*dim+j.
+		want := make([]byte, dim*4)
+		for j := 0; j < dim; j++ {
+			bits := math.Float32bits(float32(i*dim + j))
+			want[j*4+0] = byte(bits)
+			want[j*4+1] = byte(bits >> 8)
+			want[j*4+2] = byte(bits >> 16)
+			want[j*4+3] = byte(bits >> 24)
+		}
+		assert.True(t, bytes.Equal(want, values[at]), "row %d not at slice position %d", i, at)
+		at++
+	}
+
+	// The source request stays reusable for the fallback paths.
+	assert.True(t, bytes.Equal(before, inner.PlaceholderGroup))
+	assert.Equal(t, int64(nq), inner.GetNq())
+
+	// Unknown channel names disable sharding instead of guessing.
+	none, err := SliceForChannel(req, "no-dml-index-here")
+	require.NoError(t, err)
+	assert.Nil(t, none)
+}
+
+// TestScatterResult verifies the inverse mapping: a slice result is expanded
+// into the full nq row space with 0-topk rows for queries owned by other
+// ranks and densely packed ids/scores.
+func TestScatterResult(t *testing.T) {
+	const (
+		nq   = 10
+		mod  = 4
+		rank = 1
+		topk = 3
+	)
+	// Rows owned by rank 1: i = 1, 5, 9 -> 3 slice rows with 3/2/3 hits.
+	// The producer packs slice rows at a fixed stride of topk, so row 1 ends
+	// at index 3 (its last entry is padding and must be dropped).
+	sliceTopks := []int64{3, 2, 3}
+	ids := []int64{101, 102, 103, 201, 202, 0, 301, 302, 303}
+	scores := []float32{1, 2, 3, 4, 5, 0, 6, 7, 8}
+	sliced := &internalpb.SearchResults{
+		ResultData: &schemapb.SearchResultData{
+			NumQueries: 3,
+			TopK:       topk,
+			Ids:        &schemapb.IDs{IdField: &schemapb.IDs_IntId{IntId: &schemapb.LongArray{Data: ids}}},
+			Scores:     scores,
+			Topks:      sliceTopks,
+		},
+	}
+	s := &RowSlice{Rank: rank, Mod: mod, NqIn: nq, NqOut: 3, TopK: topk, ReqID: 7, Metric: "L2"}
+
+	out := ScatterResult(sliced, s)
+	require.NotNil(t, out)
+	assert.Equal(t, int64(nq), out.GetNumQueries())
+	assert.Equal(t, int64(topk), out.GetTopK())
+	require.Len(t, out.GetResultData().GetTopks(), nq)
+
+	want := map[int]int64{1: 3, 5: 2, 9: 3}
+	for i := 0; i < nq; i++ {
+		assert.Equal(t, want[i], out.GetResultData().GetTopks()[i], "topks[%d]", i)
+	}
+	assert.Equal(t, []int64{101, 102, 103, 201, 202, 301, 302, 303},
+		out.GetResultData().GetIds().GetIntId().GetData())
+	assert.Equal(t, []float32{1, 2, 3, 4, 5, 6, 7, 8}, out.GetResultData().GetScores())
+
+	// A missing slice result still answers (0 rows) so the proxy merge is not
+	// short a channel.
+	empty := ScatterResult(nil, s)
+	require.NotNil(t, empty)
+	assert.Equal(t, int64(nq), empty.GetNumQueries())
+	require.Len(t, empty.GetResultData().GetTopks(), nq)
+	for _, v := range empty.GetResultData().GetTopks() {
+		assert.Equal(t, int64(0), v)
+	}
+	assert.Empty(t, empty.GetResultData().GetIds().GetIntId().GetData())
+}

+		)
+		jobs := make(chan int, workers)
+		var wg sync.WaitGroup
+		for w := 0; w < workers; w++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				for i := range jobs {
+					if errFlag.Load() {
+						continue
+					}
+					q := queries[i]
+					var out ubcgo.UbSearchEntryResult
+					dedupeKey := dedupeSeq<<32 | uint64(uint32(reqID))
+					err := ubcgo.UbSearchEntryAsMain(dedupeKey+uint64(i), q, 1, dim,
+						topkInt, int(ef), metricType, &out)
+					if err != nil {
+						errFlag.Store(true)
+						errMu.Lock()
+						if firstErr == nil {
+							firstErr = err
+						}
+						errMu.Unlock()
+						continue
+					}
+					// force_main=true always sets out.IsMain=true on success.
+					base := i * topkInt
+					end := base + topkInt
+					if len(out.Ids) < topkInt {
+						end = base + len(out.Ids)
+					}
+					for k := 0; k < end-base; k++ {
+						allIds[base+k] = out.Ids[k]
+						allDists[base+k] = out.Dists[k]
+					}
+					topks[i] = int64(end - base)
+				}
+			}()
+		}
+		for i := 0; i < nq; i++ {
+			jobs <- i
+		}
+		close(jobs)
+		wg.Wait()
+		if errFlag.Load() {
+			return nil, firstErr
+		}
 	}
 
 	mlog.Info(ctx, "UB worker path search done",

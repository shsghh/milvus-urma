+
+// RegisterLocalChannel records that this process hosts a delegator for
+// channel. Called when a delegator is created.
+func RegisterLocalChannel(collectionID int64, channel string) {
+	if channel == "" {
+		return
+	}
+	v, _ := ubLocalChannels.LoadOrStore(collectionID, &channelSet{
+		channels: make(map[string]struct{}),
+	})
+	set, ok := v.(*channelSet)
+	if !ok {
+		return
+	}
+	set.mu.Lock()
+	set.channels[channel] = struct{}{}
+	set.mu.Unlock()
+}
+
+// UnregisterLocalChannel drops a released channel. A stale registration
+// would elect a channel that no longer receives requests, so both delegator
+// teardown paths call this.
+func UnregisterLocalChannel(collectionID int64, channel string) {
+	v, ok := ubLocalChannels.Load(collectionID)
+	if !ok {
+		return
+	}
+	set, ok := v.(*channelSet)
+	if !ok {
+		return
+	}
+	set.mu.Lock()
+	delete(set.channels, channel)
+	empty := len(set.channels) == 0
+	set.mu.Unlock()
+	if empty {
+		ubLocalChannels.Delete(collectionID)
+	}

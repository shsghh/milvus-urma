+
+// IsElectedForwardChannel reports whether channel is this process's
+// forwarder for collectionID. A process that is not tracked, or that hosts
+// a single channel of the collection, keeps the legacy behaviour (forward).
+func IsElectedForwardChannel(collectionID int64, channel string) bool {
+	v, ok := ubLocalChannels.Load(collectionID)
+	if !ok {
+		return true
+	}
+	set, ok := v.(*channelSet)
+	if !ok {
+		return true
+	}
+	set.mu.Lock()
+	defer set.mu.Unlock()
+	if len(set.channels) <= 1 {
+		return true
+	}
+	elected := ""
+	for c := range set.channels {
+		if elected == "" || c < elected {
+			elected = c
+		}
+	}
+	return elected == channel
+}
+
+// LocalChannelCount reports how many vchannels of collectionID this process
+// hosts. Diagnostic only.
+func LocalChannelCount(collectionID int64) int {
+	v, ok := ubLocalChannels.Load(collectionID)
+	if !ok {
+		return 0
+	}
+	set, ok := v.(*channelSet)
+	if !ok {
+		return 0
+	}
+	set.mu.Lock()
+	defer set.mu.Unlock()
+	return len(set.channels)
+}

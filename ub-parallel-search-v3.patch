+func rowShardingEnabled() bool {
+	return paramtable.Get().QueryNodeCfg.UbRowSharding.GetAsBool()
+}
+
+// sparseTestChannels mirrors what a real cluster allocates for an 8-shard
+// collection with rootCoord.dmlChannelNum=16: 8 channels with sparse indices.
+var sparseTestChannels = []string{
+	"by-dev-rootcoord-dml_0_9000001v0",
+	"by-dev-rootcoord-dml_1_9000001v0",
+	"by-dev-rootcoord-dml_10_9000001v1",
+	"by-dev-rootcoord-dml_11_9000001v1",
+	"by-dev-rootcoord-dml_12_9000001v2",
+	"by-dev-rootcoord-dml_13_9000001v2",
+	"by-dev-rootcoord-dml_14_9000001v3",
+	"by-dev-rootcoord-dml_15_9000001v3",
+}
+
+func registerTestCollection(t *testing.T, collectionID int64, channels []string) {
+	t.Helper()
+	for _, channel := range channels {
+		RegisterLocalChannel(collectionID, channel)
+	}
+	t.Cleanup(func() {
+		for _, channel := range channels {
+			UnregisterLocalChannel(collectionID, channel)
+		}
+	})
+}
+
+// TestChannelRankUsesLocalChannelSet pins the fix for the real-cluster
+// mismatch: an 8-shard collection gets 8 vchannels with SPARSE indices
+// (dml_0,1,10..15) while dmlChannelNum stays 16. Rank must be the dense
+// position in the local channel set and the modulus must be the channel count,
+// never the dml channel index nor dmlChannelNum.
+func TestChannelRankUsesLocalChannelSet(t *testing.T) {
+	if !rowShardingEnabled() {
+		t.Skip("row sharding disabled in this configuration")
+	}
+	const collectionID = int64(9000001)
+	SetExpectedShardCount(len(sparseTestChannels))
+	registerTestCollection(t, collectionID, sparseTestChannels)
+
+	assert.Equal(t, len(sparseTestChannels), ShardModulus(collectionID))
+
+	seen := make(map[int]string, len(sparseTestChannels))
+	for _, channel := range sparseTestChannels {
+		rank, mod, ok := ChannelRank(collectionID, channel)
+		require.True(t, ok, "channel %s must map to a rank", channel)
+		assert.Equal(t, len(sparseTestChannels), mod)
+		assert.GreaterOrEqual(t, rank, 0)
+		assert.Less(t, rank, mod)
+		other, duplicate := seen[rank]
+		assert.False(t, duplicate, "rank %d used by both %s and %s", rank, other, channel)
+		seen[rank] = channel
+	}
+	// Every rank in [0, mod) is owned by exactly one channel: the slices
+	// together cover every query row exactly once.
+	assert.Len(t, seen, len(sparseTestChannels))
+
+	// Unknown channel / incomplete set disables sharding instead of guessing.
+	_, _, ok := ChannelRank(collectionID, "by-dev-rootcoord-dml_2_9000001v0")
+	assert.False(t, ok)
+
+	UnregisterLocalChannel(collectionID, sparseTestChannels[0])
+	_, _, ok = ChannelRank(collectionID, sparseTestChannels[1])
+	assert.False(t, ok, "a partial channel set must disable sharding")
+}
+
+// TestChannelRankSingleChannelProcess verifies the fallback: a process that
+// hosts one channel cannot know its global rank, so sharding stays off.
+func TestChannelRankSingleChannelProcess(t *testing.T) {
+	if !rowShardingEnabled() {
+		t.Skip("row sharding disabled in this configuration")
+	}
+	const collectionID = int64(9000002)
+	SetExpectedShardCount(8)
+	RegisterLocalChannel(collectionID, "by-dev-rootcoord-dml_3_9000002v0")
+	t.Cleanup(func() { UnregisterLocalChannel(collectionID, "by-dev-rootcoord-dml_3_9000002v0") })
+
+	rank, mod, ok := ChannelRank(collectionID, "by-dev-rootcoord-dml_3_9000002v0")
+	assert.False(t, ok)
+	assert.Equal(t, 0, rank)
+	assert.Equal(t, 0, mod)
+}
+
+// TestSliceForChannel verifies the strided split: channel rank r owns rows
+// i%mod==r, the sliced request carries exactly those rows, the original
+// request is left untouched, and no float decode is involved.
+func TestSliceForChannel(t *testing.T) {
+	if !rowShardingEnabled() {
+		t.Skip("row sharding disabled in this configuration")
+	}
+	const collectionID = int64(9000001)
+	SetExpectedShardCount(len(sparseTestChannels))
+	registerTestCollection(t, collectionID, sparseTestChannels)
+
+	const nq, dim, topk = 10, 4, 3
+	channel := sparseTestChannels[2] // dml_10: sparse index, dense rank 1 or 2
+	rank, mod, ok := ChannelRank(collectionID, channel)
+	require.True(t, ok)
+
+	inner := makeSearchRequest(t, topk, 200, nq, dim, "L2")
+	before := append([]byte(nil), inner.PlaceholderGroup...)
+	req := &querypb.SearchRequest{Req: inner, DmlChannels: []string{channel}}
+
+	sliced, err := SliceForChannel(req, collectionID, channel)
+	require.NoError(t, err)
+	require.NotNil(t, sliced)
+
+	wantRows := 0
+	for i := 0; i < nq; i++ {
+		if i%mod == rank {
+			wantRows++
+		}
+	}
+	assert.Equal(t, rank, sliced.Rank)
+	assert.Equal(t, mod, sliced.Mod)
+	assert.Equal(t, int64(nq), sliced.NqIn)
+	assert.Equal(t, int64(wantRows), sliced.NqOut)
+	assert.Equal(t, int64(topk), sliced.TopK)
+	assert.Equal(t, int64(12345), sliced.ReqID)
+	assert.Equal(t, "L2", sliced.Metric)
+	assert.Equal(t, int64(wantRows), sliced.Request.GetReq().GetNq())
+
+	// The sliced placeholder must contain exactly the owned rows, in order.
+	group := &commonpb.PlaceholderGroup{}
+	require.NoError(t, proto.Unmarshal(sliced.Request.GetReq().GetPlaceholderGroup(), group))
+	require.Len(t, group.GetPlaceholders(), 1)
+	values := group.GetPlaceholders()[0].GetValues()
+	require.Len(t, values, wantRows)
+	at := 0
+	for i := 0; i < nq; i++ {
+		if i%mod != rank {
+			continue
+		}
+		// makeSearchRequest encodes row i as floats i*dim+j.
+		want := make([]byte, dim*4)
+		for j := 0; j < dim; j++ {
+			bits := math.Float32bits(float32(i*dim + j))
+			want[j*4+0] = byte(bits)
+			want[j*4+1] = byte(bits >> 8)
+			want[j*4+2] = byte(bits >> 16)
+			want[j*4+3] = byte(bits >> 24)
+		}
+		assert.True(t, bytes.Equal(want, values[at]), "row %d not at slice position %d", i, at)
+		at++
+	}
+
+	// The source request stays reusable for the fallback paths.
+	assert.True(t, bytes.Equal(before, inner.PlaceholderGroup))
+	assert.Equal(t, int64(nq), inner.GetNq())
+
+	// A channel outside the local set disables sharding instead of guessing.
+	none, err := SliceForChannel(req, collectionID, fmt.Sprintf(
+		"by-dev-rootcoord-dml_2_%dv0", collectionID))
+	require.NoError(t, err)
+	assert.Nil(t, none)
+}
+
+// TestScatterResult verifies the inverse mapping: a slice result is expanded
+// into the full nq row space with 0-topk rows for queries owned by other
+// ranks and densely packed ids/scores.
+func TestScatterResult(t *testing.T) {
+	const (
+		nq   = 10
+		mod  = 4
+		rank = 1
+		topk = 3
+	)
+	// Rows owned by rank 1: i = 1, 5, 9 -> 3 slice rows with 3/2/3 hits.
+	// The producer packs slice rows at a fixed stride of topk, so row 1 ends
+	// at index 3 (its last entry is padding and must be dropped).
+	sliceTopks := []int64{3, 2, 3}
+	ids := []int64{101, 102, 103, 201, 202, 0, 301, 302, 303}
+	scores := []float32{1, 2, 3, 4, 5, 0, 6, 7, 8}
+	sliced := &internalpb.SearchResults{
+		ResultData: &schemapb.SearchResultData{
+			NumQueries: 3,
+			TopK:       topk,
+			Ids:        &schemapb.IDs{IdField: &schemapb.IDs_IntId{IntId: &schemapb.LongArray{Data: ids}}},
+			Scores:     scores,
+			Topks:      sliceTopks,
+		},
+	}
+	s := &RowSlice{Rank: rank, Mod: mod, NqIn: nq, NqOut: 3, TopK: topk, ReqID: 7, Metric: "L2"}
+
+	out := ScatterResult(sliced, s)
+	require.NotNil(t, out)
+	assert.Equal(t, int64(nq), out.GetNumQueries())
+	assert.Equal(t, int64(topk), out.GetTopK())
+	require.Len(t, out.GetResultData().GetTopks(), nq)
+
+	want := map[int]int64{1: 3, 5: 2, 9: 3}
+	for i := 0; i < nq; i++ {
+		assert.Equal(t, want[i], out.GetResultData().GetTopks()[i], "topks[%d]", i)
+	}
+	assert.Equal(t, []int64{101, 102, 103, 201, 202, 301, 302, 303},
+		out.GetResultData().GetIds().GetIntId().GetData())
+	assert.Equal(t, []float32{1, 2, 3, 4, 5, 6, 7, 8}, out.GetResultData().GetScores())
+
+	// A missing slice result still answers (0 rows) so the proxy merge is not
+	// short a channel.
+	empty := ScatterResult(nil, s)
+	require.NotNil(t, empty)
+	assert.Equal(t, int64(nq), empty.GetNumQueries())
+	require.Len(t, empty.GetResultData().GetTopks(), nq)
+	for _, v := range empty.GetResultData().GetTopks() {
+		assert.Equal(t, int64(0), v)
+	}
+	assert.Empty(t, empty.GetResultData().GetIds().GetIntId().GetData())
+}

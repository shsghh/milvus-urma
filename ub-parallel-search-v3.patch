index 0000000..3db5172
--- /dev/null
+++ b/internal/core/src/index/ub_hnsw/urma_runtime/include/hnsw_urma/debug_trace.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace hnsw_urma {
+
+// Per-operation tracing (distance scheduling, progress drains, per-row entry
+// logs). Off unless UB_TRACE is set to something other than "" / "0".
+//
+// These prints sit on the critical path of every distance phase and every
+// completion. Under concurrent queries the stderr writes serialize across all
+// runtime threads and, when stderr is a pipe consumed by a slow log shipper,
+// can block them entirely — which looks exactly like a scheduler deadlock.
+// Error paths keep using fprintf directly so failures are never hidden.
+inline bool TraceEnabled() noexcept {
+  static const bool enabled = []() noexcept {
+    const char* value = std::getenv("UB_TRACE");
+    return value != nullptr && value[0] != '\0' && value[0] != '0';
+  }();
+  return enabled;
+}
+
+}  // namespace hnsw_urma
+
+#define UB_TRACE_LOG(...)                     \
+  do {                                        \
+    if (::hnsw_urma::TraceEnabled()) {        \
+      std::fprintf(stderr, __VA_ARGS__);      \
+    }                                         \
+  } while (false)

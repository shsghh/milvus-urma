+
+// TestForwardElection verifies that a multi-channel process elects exactly
+// one forwarding channel per collection, so one client search issues one P2P
+// forward instead of one per vchannel.
+func TestForwardElection(t *testing.T) {
+	const collection = int64(1001)
+
+	// Untracked collection: legacy behaviour (forward).
+	assert.True(t, IsElectedForwardChannel(collection, "chan-a"))
+	assert.Equal(t, 0, LocalChannelCount(collection))
+
+	channels := []string{
+		"by-dev-rootcoord-dml_2_xv2",
+		"by-dev-rootcoord-dml_0_xv0",
+		"by-dev-rootcoord-dml_1_xv1",
+	}
+	for _, channel := range channels {
+		RegisterLocalChannel(collection, channel)
+	}
+	require.Equal(t, len(channels), LocalChannelCount(collection))
+
+	elected := 0
+	for _, channel := range channels {
+		if IsElectedForwardChannel(collection, channel) {
+			elected++
+			assert.Equal(t, "by-dev-rootcoord-dml_0_xv0", channel)
+		}
+	}
+	assert.Equal(t, 1, elected)
+
+	// Another collection in the same process elects independently.
+	const otherCollection = int64(2002)
+	RegisterLocalChannel(otherCollection, "by-dev-rootcoord-dml_7_yv0")
+	RegisterLocalChannel(otherCollection, "by-dev-rootcoord-dml_3_yv0")
+	assert.True(t, IsElectedForwardChannel(otherCollection, "by-dev-rootcoord-dml_3_yv0"))
+	assert.False(t, IsElectedForwardChannel(otherCollection, "by-dev-rootcoord-dml_7_yv0"))
+	// The first collection is unaffected.
+	assert.True(t, IsElectedForwardChannel(collection, "by-dev-rootcoord-dml_0_xv0"))
+
+	// Releasing the elected channel moves the election to the next one.
+	UnregisterLocalChannel(collection, "by-dev-rootcoord-dml_0_xv0")
+	assert.True(t, IsElectedForwardChannel(collection, "by-dev-rootcoord-dml_1_xv1"))
+	assert.False(t, IsElectedForwardChannel(collection, "by-dev-rootcoord-dml_2_xv2"))
+
+	for _, channel := range channels[1:] {
+		UnregisterLocalChannel(collection, channel)
+	}
+	UnregisterLocalChannel(otherCollection, "by-dev-rootcoord-dml_7_yv0")
+	UnregisterLocalChannel(otherCollection, "by-dev-rootcoord-dml_3_yv0")
+
+	// Fully released: registry entry is gone and the legacy default returns.
+	assert.Equal(t, 0, LocalChannelCount(collection))
+	assert.True(t, IsElectedForwardChannel(collection, "chan-a"))
+}
+
+// TestEmptySearchResultsShape pins the "channel contributed no rows" wire
+// shape: request nq/topk, zero topks and empty ids/scores, which is what the
+// proxy reduce accepts for a channel with no matches.
+func TestEmptySearchResultsShape(t *testing.T) {
+	req := &internalpb.SearchRequest{
+		ReqID:        7,
+		Nq:           2,
+		Topk:         3,
+		MetricType:   "L2",
+		CollectionID: 42,
+	}
+	res := EmptySearchResults(req)
+
+	require.NotNil(t, res)
+	assert.True(t, merr.Ok(res.GetStatus()))
+	assert.Equal(t, int64(2), res.GetNumQueries())
+	assert.Equal(t, int64(3), res.GetTopK())
+	require.NotNil(t, res.GetResultData())
+	assert.Equal(t, int64(2), res.GetResultData().GetNumQueries())
+	assert.Equal(t, int64(3), res.GetResultData().GetTopK())
+	require.Len(t, res.GetResultData().GetTopks(), 2)
+	for _, topk := range res.GetResultData().GetTopks() {
+		assert.Equal(t, int64(0), topk)
+	}
+	assert.Empty(t, res.GetResultData().GetIds().GetIntId().GetData())
+	assert.Empty(t, res.GetResultData().GetScores())
+}

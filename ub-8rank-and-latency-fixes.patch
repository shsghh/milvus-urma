diff --git a/deploy_8rank_streamingnodes.sh b/deploy_8rank_streamingnodes.sh
new file mode 100644
index 0000000..f4a2462
--- /dev/null
+++ b/deploy_8rank_streamingnodes.sh
@@ -0,0 +1,129 @@
+#!/bin/bash
+# Milvus 3.0 UB (hnsw_urma) TRUE 8-rank startup: one streamingnode per rank.
+#
+# Why this layout
+# ---------------
+# In Milvus 3.0 the search entry point (vchannel shard leader / delegator) is
+# pinned to the QueryNode embedded in a *streamingnode*
+# (cmd/milvus/util.go: StreamingNodeRole => EnableStreamingNode && EnableQueryNode,
+# label STREAMING-EMBEDDED; querycoord's channel filter keeps only those nodes,
+# see internal/querycoordv2/assign/assign_policy_components.go).
+# A plain `milvus run querynode` therefore NEVER receives a channel and never
+# serves a search -- the 8 worker QNs in the old script only held memory.
+#
+# So the rank count == streamingnode count, not querynode count:
+#   * 8 streamingnodes: each hosts the embedded QN that owns one vchannel and
+#     seeds exactly one UB shard (rank i). Each is the main rank for the
+#     queries whose req_id % 8 == i.
+#   * a few plain querynodes: they only host Milvus segments (the embedded QN
+#     is excluded from resource groups, so segments must live somewhere else).
+#     They must NOT seed UB shards: one publisher per shard keeps the resource
+#     directory unambiguous (duplicate records would make peer-handle import
+#     order-dependent and double the registered memory).
+#
+# Ports: queryNode.port is bound by the embedded QN of each SN process, so every
+# SN needs its own.
+#
+# Verify afterwards:
+#   grep -h 'UB SearchEntry: main' /tmp/sn8-sn_*.log | wc -l   # ~= nq total
+#   grep -h 'serving search from local readers' /tmp/sn8-sn_*.log  # must be EMPTY
+#     (each SN owns 1/8 of the shards, so the URMA data plane is mandatory)
+#   leaderview/GetChannelJSON: channel_node_infos leaders spread over 8 SN node IDs
+#
+set -u
+
+MILVUS_HOME=${MILVUS_HOME:-/home/s00800245/milvus-3.0.0}
+UB_SEED_DIR=${UB_SEED_DIR:-/home/s00800245/index/gist_8_urma}
+SHARDS=${SHARDS:-8}
+LOG_DIR=${LOG_DIR:-/tmp}
+
+# Per-process UB thread budget. Keep this small: the auto formula derives
+# search = cpus - distance - read - rpc - reserve, so on a 96-CPU cgroup each
+# process would start ~90 threads and 9 processes would fight for one cpuset.
+UB_SEARCH=${UB_SEARCH:-8}
+UB_DISTANCE=${UB_DISTANCE:-1}
+UB_READ=${UB_READ:-8}
+UB_RPC=${UB_RPC:-1}
+UB_MAX_ACTIVE=${UB_MAX_ACTIVE:-8}
+
+cd "$MILVUS_HOME" || exit 1
+export LD_LIBRARY_PATH="$MILVUS_HOME/internal/core/output/lib/:${LD_LIBRARY_PATH:-}"
+export LD_PRELOAD="$MILVUS_HOME/internal/core/output/lib/libjemalloc.so"
+export MALLOC_CONF=background_thread:true
+unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY ftp_proxy
+
+echo '=== 0. stop everything from a previous run ==='
+for p in $(ps -eo pid,args | grep -E 'milvus run' | grep -v grep | awk '{print $1}'); do
+  kill -9 "$p" 2>/dev/null
+  pkill -9 -P "$p" 2>/dev/null
+done
+sleep 5
+
+echo '=== 1. coordinators (dmlChannelNum must equal the shard count) ==='
+# One pchannel per shard is what lets 8 SNs hold 8 vchannels one-to-one; with
+# the default 16 pchannels two vchannels can land on the same SN and the
+# req_id % 8 rotation then leaves some shards unserved (silent empty results).
+MILVUS_CONF_rootcoordDmlChannelNum=$SHARDS \
+METRICS_PORT=9100 nohup "$MILVUS_HOME/bin/milvus" run mixcoord --run-with-subprocess \
+  > "$LOG_DIR/sn8-mixcoord.log" 2>&1 &
+sleep 20
+
+echo '=== 2. datanode ==='
+METRICS_PORT=9110 nohup "$MILVUS_HOME/bin/milvus" run datanode --run-with-subprocess \
+  > "$LOG_DIR/sn8-datanode.log" 2>&1 &
+sleep 8
+
+echo '=== 3. one streamingnode per rank (embedded QN = channel leader + UB rank) ==='
+for s in $(seq 0 $((SHARDS - 1))); do
+  MILVUS_CONF_querynodeport=$((21300 + s + 1)) \
+  MILVUS_CONF_querynodeUbSeedDir="$UB_SEED_DIR" \
+  MILVUS_CONF_querynodeUbShardIds="$s" \
+  MILVUS_CONF_querynodeUbMaxActiveQueries="$UB_MAX_ACTIVE" \
+  MILVUS_CONF_querynodeUbThreadsSearch="$UB_SEARCH" \
+  MILVUS_CONF_querynodeUbThreadsDistance="$UB_DISTANCE" \
+  MILVUS_CONF_querynodeUbThreadsReadProgress="$UB_READ" \
+  MILVUS_CONF_querynodeUbThreadsRpcProgress="$UB_RPC" \
+  METRICS_PORT=$((9101 + s)) \
+  nohup "$MILVUS_HOME/bin/milvus" run streamingnode --run-with-subprocess \
+    > "$LOG_DIR/sn8-sn_$s.log" 2>&1 &
+  sleep 3
+done
+sleep 15
+
+echo '=== 4. segment hosts (plain querynodes, NO UB seed) ==='
+# These never serve search; they only own segments so the collection can reach
+# the Loaded state (the embedded QN cannot be assigned segments).
+# seedDir MUST be cleared explicitly: milvus.yaml sets a default path, and a
+# second seeder per shard would publish duplicate resource records.
+for q in 1 2; do
+  MILVUS_CONF_querynodeport=$((21400 + q)) \
+  MILVUS_CONF_querynodeUbSeedDir= \
+  METRICS_PORT=$((9120 + q)) \
+  nohup "$MILVUS_HOME/bin/milvus" run querynode --run-with-subprocess \
+    > "$LOG_DIR/sn8-qn_$q.log" 2>&1 &
+  sleep 3
+done
+sleep 10
+
+echo '=== 5. proxy ==='
+METRICS_PORT=9130 nohup "$MILVUS_HOME/bin/milvus" run proxy --run-with-subprocess \
+  > "$LOG_DIR/sn8-proxy.log" 2>&1 &
+sleep 30
+
+echo '=== 6. ports ==='
+ss -tlnp 2>/dev/null | grep -E '19530|9100|9110|91(0[1-8]|2[0-9])|213(0[1-8])|214(01|02)'
+
+echo '=== 7. UB seed: each SN must report loadedShards=1 expectedShards=8 ==='
+grep -h 'UB seed from dir done' "$LOG_DIR"/sn8-sn_*.log 2>/dev/null | tail -20
+
+echo '=== 8. UB rank verification (run after the first search) ==='
+echo "-- main-rank lines per SN (each line is one query this SN answered) --"
+for s in $(seq 0 $((SHARDS - 1))); do
+  printf 'sn_%s: %s\n' "$s" \
+    "$(grep -c 'UB SearchEntry: main' "$LOG_DIR/sn8-sn_$s.log" 2>/dev/null || echo 0)"
+done
+echo '-- local-reader fallbacks (must be empty for 1-shard ranks) --'
+grep -h 'serving search from local readers' "$LOG_DIR"/sn8-sn_*.log 2>/dev/null || true
+echo '-- URMA read pressure: ops and submit->completion latency --'
+grep -h 'event=read_timeout' "$LOG_DIR"/sn8-sn_*.log 2>/dev/null | tail -5 || true
+echo '=== DONE ==='

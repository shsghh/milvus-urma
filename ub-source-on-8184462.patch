+// Opt-in search trace, used to diff a working layout against a broken one
+// (for example 1 SN with a full seed vs 8 SNs with one shard each). The first
+// divergence between the two traces localises the bug as "wrong graph data",
+// "wrong distances" or "wrong traversal" without guessing.
+//
+//   UB_TRACE_SEARCH=1       enable (default off)
+//   UB_TRACE_SEARCH_MAX=n   number of trace lines per process (default 64)
+//   UB_TRACE_SEARCH_SKIP=n  skip the first n trace slots (default 0), so a
+//                           later query can be traced after the first ones
+//
+// Disabled runs pay one cached static bool and never call getenv again.
+bool UbTraceSearchEnabled() {
+  static const bool enabled = []() {
+    const char* raw = std::getenv("UB_TRACE_SEARCH");
+    return raw != nullptr && raw[0] != '\0' && raw[0] != '0';
+  }();
+  return enabled;
+}
+
+std::uint64_t UbTraceEnvU64(const char* name, std::uint64_t fallback) {
+  const char* raw = std::getenv(name);
+  if (raw == nullptr || raw[0] == '\0') {
+    return fallback;
+  }
+  const unsigned long long parsed = std::strtoull(raw, nullptr, 10);
+  return parsed == 0 ? fallback : static_cast<std::uint64_t>(parsed);
+}
+
+std::uint64_t UbTraceSkip() {
+  static const std::uint64_t skip = UbTraceEnvU64("UB_TRACE_SEARCH_SKIP", 0);
+  return skip;
+}
+
+std::uint64_t UbTraceLimit() {
+  static const std::uint64_t limit = UbTraceEnvU64("UB_TRACE_SEARCH_MAX", 64);
+  return limit;
+}
+
+// Returns true while this call is inside [skip, skip + limit).
+bool UbTraceTake() {
+  if (!UbTraceSearchEnabled()) {
+    return false;
+  }
+  static std::atomic<std::uint64_t> counter{0};
+  const auto index = counter.fetch_add(1, std::memory_order_relaxed);
+  const auto skip = UbTraceSkip();
+  return index >= skip && index < skip + UbTraceLimit();
+}

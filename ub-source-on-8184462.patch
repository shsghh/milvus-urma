+package querynodev2
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/milvus-io/milvus/internal/util/urma"
+	"github.com/milvus-io/milvus/pkg/v3/mlog"
+)
+
+// ubResourceCache keeps the last consistent URMA resource-directory snapshot
+// so the UB search fast path does not pay for it on every request.
+//
+// ResourceDirectory.Snapshot issues one etcd prefix Get plus one TimeToLive
+// call per published record. With 8 shards x 2 roles that is 17 etcd round
+// trips per search, all on the critical path before the UB runtime is even
+// entered. The directory is lease-bound and changes only on load/unload, so a
+// short-lived cache with stale-while-revalidate semantics is safe: a record
+// that disappears is still validated by the link cache and by the READ itself,
+// and a stale entry can only cost one failed activation attempt.
+//
+// Reads never block on the refresh except for the very first snapshot: a stale
+// snapshot is served immediately while a background goroutine refreshes it.
+type ubResourceCache struct {
+	directory urma.ResourceDirectory
+	ttl       time.Duration
+	// baseCtx outlives individual searches so a background refresh started by
+	// one request is not cancelled when that request returns.
+	baseCtx context.Context
+
+	mu         sync.Mutex
+	records    []urma.ResourceRecord
+	revision   int64
+	fetchedAt  time.Time
+	refreshing bool
+	refreshCh  chan struct{}
+}
+
+// newUbResourceCache returns nil when caching is disabled (ttl <= 0) so the
+// caller can fall back to a direct Snapshot on every search.
+func newUbResourceCache(ctx context.Context, directory urma.ResourceDirectory, ttl time.Duration) *ubResourceCache {
+	if directory == nil || ttl <= 0 {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return &ubResourceCache{directory: directory, ttl: ttl, baseCtx: ctx}
+}
+
+// Snapshot returns the cached records when they are still fresh, a stale copy
+// while a background refresh runs, and otherwise blocks for one fetch. The
+// returned slice is shared and must be treated as read-only.
+func (c *ubResourceCache) Snapshot(ctx context.Context) ([]urma.ResourceRecord, int64, error) {
+	if c == nil {
+		return nil, 0, nil
+	}
+	for {
+		c.mu.Lock()
+		hasData := c.records != nil
+		fresh := hasData && time.Since(c.fetchedAt) < c.ttl
+		if fresh {
+			records, revision := c.records, c.revision
+			c.mu.Unlock()
+			return records, revision, nil
+		}
+		if hasData {
+			// Stale but usable: serve it now and let a background refresh
+			// replace the contents. This keeps search off the etcd path.
+			if !c.refreshing {
+				c.startRefreshLocked()
+			}
+			records, revision := c.records, c.revision
+			c.mu.Unlock()
+			return records, revision, nil
+		}
+		if c.refreshing {
+			// First snapshot in flight: wait for it instead of issuing a
+			// duplicate prefix Get.
+			wait := c.refreshCh
+			c.mu.Unlock()
+			select {
+			case <-wait:
+				continue
+			case <-ctx.Done():
+				return nil, 0, ctx.Err()
+			}
+		}
+		c.refreshing = true
+		c.refreshCh = make(chan struct{})
+		wait := c.refreshCh
+		c.mu.Unlock()
+
+		records, revision, err := c.directory.Snapshot(ctx)
+
+		c.mu.Lock()
+		c.refreshing = false
+		c.refreshCh = nil
+		if err == nil {
+			c.records = records
+			c.revision = revision
+			c.fetchedAt = time.Now()
+		}
+		c.mu.Unlock()
+		close(wait)
+		if err != nil {
+			return nil, 0, err
+		}
+		return records, revision, nil
+	}
+}
+
+// startRefreshLocked kicks a background refresh. The caller must hold c.mu.
+func (c *ubResourceCache) startRefreshLocked() {
+	c.refreshing = true
+	c.refreshCh = make(chan struct{})
+	done := c.refreshCh
+	go func() {
+		records, revision, err := c.directory.Snapshot(c.baseCtx)
+		c.mu.Lock()
+		c.refreshing = false
+		c.refreshCh = nil
+		if err == nil {
+			c.records = records
+			c.revision = revision
+			c.fetchedAt = time.Now()
+		}
+		c.mu.Unlock()
+		close(done)
+		if err != nil {
+			// Keep the previous snapshot: a transient etcd error must not take
+			// the search path down, and the next request will retry.
+			mlog.Warn(c.baseCtx, "URMA resource snapshot refresh failed; keeping the previous snapshot",
+				mlog.Err(err))
+		}
+	}()
+}
+
+// Invalidate forces the next Snapshot call to refetch synchronously.
+func (c *ubResourceCache) Invalidate() {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	c.fetchedAt = time.Time{}
+	c.mu.Unlock()
+}

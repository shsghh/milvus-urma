+)
+
+// fakeResourceDirectory implements only Snapshot; the cache never calls the
+// other directory methods. The embedded interface keeps that explicit.
+type fakeResourceDirectory struct {
+	urma.ResourceDirectory
+	calls   atomic.Int32
+	records []urma.ResourceRecord
+	err     error
+	delay   time.Duration
+}
+
+func (f *fakeResourceDirectory) Snapshot(ctx context.Context) ([]urma.ResourceRecord, int64, error) {
+	f.calls.Add(1)
+	if f.delay > 0 {
+		select {
+		case <-time.After(f.delay):
+		case <-ctx.Done():
+			return nil, 0, ctx.Err()
+		}
+	}
+	if f.err != nil {
+		return nil, 0, f.err
+	}
+	return f.records, int64(f.calls.Load()), nil
+}
+
+func TestUbResourceCacheDisabledWhenTTLZero(t *testing.T) {
+	dir := &fakeResourceDirectory{records: []urma.ResourceRecord{{SegmentID: "a"}}}
+	assert.Nil(t, newUbResourceCache(context.Background(), dir, 0))
+	assert.Nil(t, newUbResourceCache(context.Background(), nil, time.Second))
+
+	var nilCache *ubResourceCache
+	records, revision, err := nilCache.Snapshot(context.Background())
+	require.NoError(t, err)
+	assert.Nil(t, records)
+	assert.Zero(t, revision)
+}
+
+func TestUbResourceCacheReusesFreshSnapshot(t *testing.T) {
+	dir := &fakeResourceDirectory{
+		records: []urma.ResourceRecord{{SegmentID: "shard-0"}, {SegmentID: "shard-1"}},
+	}
+	cache := newUbResourceCache(context.Background(), dir, time.Hour)
+	require.NotNil(t, cache)
+
+	first, revision, err := cache.Snapshot(context.Background())
+	require.NoError(t, err)
+	assert.Len(t, first, 2)
+	assert.Equal(t, int64(1), revision)
+
+	second, _, err := cache.Snapshot(context.Background())
+	require.NoError(t, err)
+	assert.Equal(t, first, second)
+	// A fresh snapshot must not reach etcd again.
+	assert.Equal(t, int32(1), dir.calls.Load())
+}
+
+func TestUbResourceCacheServesStaleWhileRefreshing(t *testing.T) {
+	dir := &fakeResourceDirectory{
+		records: []urma.ResourceRecord{{SegmentID: "shard-0"}},
+		delay:   50 * time.Millisecond,
+	}
+	cache := newUbResourceCache(context.Background(), dir, time.Millisecond)
+
+	records, _, err := cache.Snapshot(context.Background())
+	require.NoError(t, err)
+	require.Len(t, records, 1)
+
+	time.Sleep(5 * time.Millisecond)
+
+	// Stale: the cached copy is returned immediately and a refresh starts in
+	// the background, so the search never blocks on etcd here.
+	started := time.Now()
+	stale, _, err := cache.Snapshot(context.Background())
+	require.NoError(t, err)
+	assert.Len(t, stale, 1)
+	assert.Less(t, time.Since(started), dir.delay)
+
+	// The background refresh must reach the directory exactly once more.
+	require.Eventually(t, func() bool { return dir.calls.Load() == 2 }, 2*time.Second, 5*time.Millisecond)
+}
+
+func TestUbResourceCacheRetriesAfterFirstFetchError(t *testing.T) {
+	dir := &fakeResourceDirectory{err: errors.New("etcd unavailable")}
+	cache := newUbResourceCache(context.Background(), dir, time.Hour)
+
+	_, _, err := cache.Snapshot(context.Background())
+	require.Error(t, err)
+	assert.Equal(t, int32(1), dir.calls.Load())
+
+	// No snapshot was cached, so the next call must try again instead of
+	// serving an empty directory.
+	dir.err = nil
+	dir.records = []urma.ResourceRecord{{SegmentID: "shard-0"}}
+	records, _, err := cache.Snapshot(context.Background())
+	require.NoError(t, err)
+	assert.Len(t, records, 1)
+	assert.Equal(t, int32(2), dir.calls.Load())
+}

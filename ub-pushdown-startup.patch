+// Builds the distance-pushdown data plane. Called once at the end of
+// EnableDistributedSearchLocked and again, on demand, from TryEnablePushdown():
+// the rpc mailbox rings are allocated with the data plane, so a peer can only
+// publish its rings after it enabled, which is after this node may have
+// enabled. Hence the retry path.
+Status MilvusUbRuntime::EnablePushdownLocked(DistributedState& state) {
+  if (state.pushdown_active) {
+    return Status::Ok();
+  }
+  if (!knobs_.pushdown || !state.rpc_memory || !state.backend ||
+      state.local_shard == nullptr || !state.effective || meta_ == nullptr ||
+      state.engines.empty()) {
+    return Status(StatusCode::kUnavailable, "pushdown prerequisites missing");
+  }
+  const auto& cfg = *state.effective;
+  const std::uint32_t rpc_threads = cfg.rpc_progress_threads;
+  if (rpc_threads == 0 ||
+      state.engines.size() <
+          static_cast<std::size_t>(cfg.read_progress_threads) + rpc_threads) {
+    return Status(StatusCode::kUnavailable, "pushdown rpc lanes missing");
+  }
+  // Every remote rank must have published its three mailbox rings (roles 2..4).
+  for (std::uint32_t rank = 0; rank < state.world_size; ++rank) {
+    if (rank == state.local_rank) {
+      continue;
+    }
+    for (std::uint32_t role = 2; role <= 4; ++role) {
+      if (peer_handles_.find({static_cast<shard_id_t>(rank), role}) ==
+          peer_handles_.end()) {
+        return Status(StatusCode::kUnavailable,
+                      "peer rpc mailbox not imported yet");
+      }
+    }
+  }
+  // Replacing the oracle invalidates every reference held by an in-flight
+  // search, so only swap when the FIFO is empty.
+  if (state.active_queries != 0) {
+    return Status(StatusCode::kUnavailable, "queries in flight");
+  }
+
+  std::vector<std::uint32_t> shard_to_rank(state.world_size);
+  std::vector<std::uint32_t> rpc_owner_by_rank(state.world_size);
+  for (std::uint32_t rank = 0; rank < state.world_size; ++rank) {
+    shard_to_rank[rank] = rank;  // shard i is served by rank i
+    rpc_owner_by_rank[rank] = rank % rpc_threads;
+  }
+  const std::uint32_t max_ids = static_cast<std::uint32_t>(meta_->M0);
+
+  auto rpc_distance = RpcDistanceOracle::Create(
+      cfg.search_workers, rpc_threads, cfg.queues.depths.rpc_submit,
+      state.max_active_queries * max_ids, max_ids, meta_->dim, state.local_rank,
+      shard_to_rank, rpc_owner_by_rank, cfg.read_progress_threads,
+      state.use_dot_norm);
+  if (!rpc_distance.ok()) {
+    return rpc_distance.status();
+  }
+  state.rpc_distance = std::move(rpc_distance).value();
+
+  std::vector<std::uint32_t> slots;
+  slots.reserve(cfg.remote_tasks.owners.size());
+  for (const auto& owner_capacity : cfg.remote_tasks.owners) {
+    slots.push_back(
+        static_cast<std::uint32_t>(owner_capacity.actual_remote_task_slots));
+  }
+  auto rpc_server = RpcServerRuntime::Create(
+      slots, cfg.distance_workers, cfg.queues.depths.service, max_ids,
+      state.local_rank, shard_to_rank, rpc_owner_by_rank,
+      cfg.query_cache_entries, meta_->dim, state.request_ring_depth,
+      cfg.query_cache_entries_per_owner);
+  if (!rpc_server.ok()) {
+    return rpc_server.status();
+  }
+  state.rpc_server = std::move(rpc_server).value();
+
+  for (std::uint32_t owner = 0; owner < rpc_threads; ++owner) {
+    auto client = RpcClientOwner::Create(
+        owner, state.world_size, state.max_active_queries * max_ids,
+        state.rpc_distance->submissions(), state.max_active_queries,
+        state.profile, state.rpc_distance.get());
+    if (!client.ok()) {
+      return client.status();
+    }
+    state.rpc_clients.push_back(std::move(client).value());
+
+    std::vector<std::uint32_t> owned;
+    for (std::uint32_t rank = 0; rank < state.world_size; ++rank) {
+      if (rpc_owner_by_rank[rank] == owner) {
+        owned.push_back(rank);
+      }
+    }
+    RpcTransportConfig transport_config;
+    transport_config.owner_thread = owner;
+    transport_config.transport_lane = cfg.read_progress_threads + owner;
+    transport_config.local_rank = state.local_rank;
+    transport_config.request_batch_max_tasks =
+        cfg.rpc_request_batch_max_tasks;
+    transport_config.request_batch_max_bytes =
+        cfg.rpc_request_batch_max_bytes;
+    transport_config.response_batch_max_tasks =
+        cfg.rpc_response_batch_max_tasks;
+    transport_config.response_batch_max_bytes =
+        cfg.rpc_response_batch_max_bytes;
+    transport_config.profiling_enabled = state.profile;
+    const std::size_t lane = transport_config.transport_lane;
+    if (lane >= state.engines.size() || !state.engines[lane]) {
+      return Status(StatusCode::kUnavailable,
+                    "pushdown rpc lane engine missing");
+    }
+    auto transport = RpcTransportOwner::Create(
+        transport_config, owned, *state.engines[lane], *state.backend,
+        *state.rpc_memory, *state.rpc_clients.back(), *state.rpc_server);
+    if (!transport.ok()) {
+      return transport.status();
+    }
+    state.rpc_transports.push_back(std::move(transport).value());
+  }
+
+  auto hybrid = HybridDistanceOracle::Create(
+      state.local_shard->range().shard_id, DistancePolicy::kAuto, 4,
+      *state.pull_distance, *state.rpc_distance,
+      state.max_active_queries * 8U);
+  if (!hybrid.ok()) {
+    return hybrid.status();
+  }
+  state.hybrid_distance = std::move(hybrid).value();
+  state.pushdown_active = true;
+  LOG_INFO("UB pushdown enabled: peers={} rpc_threads={}",
+           state.world_size - 1, rpc_threads);
+  return Status::Ok();
+}
+
+Status MilvusUbRuntime::TryEnablePushdown() {
+  std::lock_guard<std::mutex> lock(state_mutex_);
+  if (!distributed_runtime_) {
+    return Status(StatusCode::kUnavailable,
+                  "distributed runtime not enabled");
+  }
+  return EnablePushdownLocked(*distributed_runtime_);
+}
+
+bool MilvusUbRuntime::DistributedEnabled() {
+  std::lock_guard<std::mutex> lock(state_mutex_);
+  return distributed_runtime_ != nullptr;
+}

+// publishUbRpcMailboxes publishes the rank-scoped RPC mailbox rings used by
+// distance pushdown. They can only be published once the distributed runtime
+// exists, because the rings are allocated with it (C++ side). ShardID carries
+// the rank: in this deployment one streaming node owns exactly one shard and
+// shard i is served by rank i.
+func (node *QueryNode) publishUbRpcMailboxes(ctx context.Context) {
+	if !paramtable.Get().QueryNodeCfg.UbEnabled.GetAsBool() ||
+		!paramtable.Get().QueryNodeCfg.UbPushdown.GetAsBool() {
+		return
+	}
+	addrs, sizes, ok := initcore.UbRpcMailboxRegions()
+	if !ok {
+		mlog.Info(ctx, "UB pushdown: rpc mailbox regions not available; skip publish")
+		return
+	}
+	_, _, _, _, shardIDs, err := initcore.UbShardRegions()
+	if err != nil || len(shardIDs) == 0 {
+		mlog.Warn(ctx, "UB pushdown: cannot resolve local rank for mailbox publish", mlog.Err(err))
+		return
+	}
+	rank := shardIDs[0]
+	shardCount := initcore.UbExpectedShardCount()
+	if shardCount == 0 {
+		shardCount = rank + 1
+	}
+	_, entryVertexID, err := initcore.UbEntryPoint()
+	if err != nil {
+		mlog.Warn(ctx, "UB pushdown: cannot read entry point for mailbox publish", mlog.Err(err))
+		return
+	}
+	entryShardID, err := initcore.UbEntryShard()
+	if err != nil {
+		mlog.Warn(ctx, "UB pushdown: cannot resolve entry shard for mailbox publish", mlog.Err(err))
+		return
+	}
+	roles := []urma.GlobalResourceRole{
+		urma.ResourceRoleTaskQueue,
+		urma.ResourceRoleResultQueue,
+		urma.ResourceRoleNotifyQueue,
+	}
+	names := []string{"requests", "responses", "notify"}
+	for i, role := range roles {
+		segmentID := fmt.Sprintf("ub-graph-%d-rpc-%s", rank, names[i])
+		if err := node.RegisterAndPublishUrmaGraphResource(ctx, segmentID, 1,
+			unsafe.Pointer(uintptr(addrs[i])), sizes[i], "ub-hnsw", 1,
+			rank, shardCount, entryShardID, entryVertexID, role); err != nil {
+			mlog.Warn(ctx, "UB pushdown: failed to publish rpc mailbox segment",
+				mlog.String("segment", segmentID), mlog.Err(err))
+			continue
+		}
+		mlog.Info(ctx, "UB pushdown: published rpc mailbox segment",
+			mlog.String("segment", segmentID), mlog.Uint64("bytes", sizes[i]))
+	}
+}

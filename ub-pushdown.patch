+bool MilvusUbRuntime::RpcMailboxRegions(RpcMailboxRegion out[3]) const {
+  std::lock_guard<std::mutex> lock(state_mutex_);
+  if (!distributed_runtime_ || !distributed_runtime_->rpc_memory) {
+    return false;
+  }
+  const auto& memory = *distributed_runtime_->rpc_memory;
+  const std::array<std::span<std::byte>, 3> regions{
+      memory.request_registration(), memory.response_registration(),
+      memory.notify_registration()};
+  for (std::size_t i = 0; i < regions.size(); ++i) {
+    out[i].address = reinterpret_cast<std::uint64_t>(regions[i].data());
+    out[i].bytes = static_cast<std::uint64_t>(regions[i].size());
+  }
+  return true;
+}

+func UbRpcMailboxRegions() (addrs []uint64, sizes []uint64, ok bool) {
+	addrs = make([]uint64, 3)
+	sizes = make([]uint64, 3)
+	ret := C.UbRpcMailboxRegions((*C.uint64_t)(unsafe.Pointer(&addrs[0])),
+		(*C.uint64_t)(unsafe.Pointer(&sizes[0])))
